---
/** RelayCore architecture diagram (themeable SVG) */
---
<div class="diagram-wrapper">
  <svg
    class="architecture-svg"
    viewBox="0 0 920 612"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label="RelayCore crate architecture"
  >
    <defs>
      <marker id="arch-arrow" markerWidth="7" markerHeight="7" refX="5.5" refY="3.5" orient="auto">
        <path d="M0 0 L7 3.5 L0 7 Z" class="marker-fill marker-fill-solid" />
      </marker>
      <marker id="arch-arrow-optional" markerWidth="7" markerHeight="7" refX="5.5" refY="3.5" orient="auto">
        <path d="M0 0 L7 3.5 L0 7 Z" class="marker-fill marker-fill-optional" />
      </marker>
      <filter id="arch-glow" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="2" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
    </defs>

    <!-- ── Adapter layer ── -->
    <g class="layer">
      <rect x="16" y="16" width="888" height="132" rx="6" class="layer-frame" />
      <text x="32" y="34" class="layer-title">ADAPTER LAYER</text>
      <text x="32" y="48" class="layer-subtitle">public crates</text>

      <g class="node node-public" transform="translate(36, 56)">
        <rect width="200" height="80" rx="4" />
        <text x="12" y="20" class="badge badge-public">PUBLIC</text>
        <text x="12" y="40" class="node-name">relay-core-http</text>
        <text x="12" y="58" class="node-desc">REST + SSE</text>
      </g>

      <g class="node node-public" transform="translate(252, 56)">
        <rect width="200" height="80" rx="4" />
        <text x="12" y="20" class="badge badge-public">PUBLIC</text>
        <text x="12" y="40" class="node-name">relay-core-probe</text>
        <text x="12" y="58" class="node-desc">MCP · AI</text>
      </g>

      <g class="node node-public" transform="translate(468, 56)">
        <rect width="200" height="80" rx="4" />
        <text x="12" y="20" class="badge badge-public">PUBLIC</text>
        <text x="12" y="40" class="node-name">relay-core-tauri</text>
        <text x="12" y="58" class="node-desc">RelayCraft</text>
      </g>

      <g class="node node-public" transform="translate(684, 56)">
        <rect width="200" height="80" rx="4" />
        <text x="12" y="20" class="badge badge-public">PUBLIC</text>
        <text x="12" y="40" class="node-name">relay-core-cli</text>
        <text x="12" y="58" class="node-desc">CLI · TUI · embedded HTTP</text>
      </g>
    </g>

    <g class="connectors">
      <line x1="136" y1="136" x2="136" y2="150" class="connector" />
      <line x1="352" y1="136" x2="352" y2="150" class="connector" />
      <line x1="568" y1="136" x2="568" y2="150" class="connector" />
      <line x1="784" y1="136" x2="784" y2="150" class="connector" />
      <path d="M 136 150 L 784 150" class="connector" fill="none" />
      <line x1="460" y1="150" x2="460" y2="168" class="connector" marker-end="url(#arch-arrow)" />
    </g>

    <!-- ── API ── -->
    <g class="node node-internal" transform="translate(240, 172)">
      <rect width="440" height="60" rx="4" />
      <text x="16" y="22" class="badge badge-internal">INTERNAL</text>
      <text x="16" y="40" class="node-name">relay-core-api</text>
      <text x="16" y="54" class="node-desc">Flow · Rule · Policy · Event</text>
    </g>
    <line x1="460" y1="232" x2="460" y2="248" class="connector" marker-end="url(#arch-arrow)" />

    <!-- ── Runtime ── -->
    <g class="node node-public node-runtime" transform="translate(180, 250)">
      <rect width="560" height="100" rx="4" filter="url(#arch-glow)" />
      <text x="16" y="22" class="badge badge-public">PUBLIC</text>
      <text x="16" y="40" class="node-name">relay-core-runtime</text>
      <rect x="20" y="50" width="520" height="42" rx="3" class="node-nested" />
      <text x="36" y="68" class="node-name node-name-nested">CoreState</text>
      <text x="36" y="84" class="node-desc">lifecycle · rule store · event bus · proxy spawn</text>
    </g>
    <line x1="460" y1="350" x2="460" y2="366" class="connector" marker-end="url(#arch-arrow)" />

    <!-- ── Engine ── -->
    <g class="layer layer-engine">
      <rect x="16" y="372" width="888" height="232" rx="6" class="layer-frame layer-frame-engine" />
      <text x="32" y="390" class="layer-title">ENGINE</text>
      <text x="32" y="404" class="layer-subtitle">internal crates</text>

      <!-- lib (top, full width) -->
      <g class="node node-internal node-lib" transform="translate(32, 416)">
        <rect width="856" height="84" rx="4" />
        <text x="16" y="22" class="badge badge-internal">INTERNAL</text>
        <text x="16" y="40" class="node-name">relay-core-lib</text>
        <text x="16" y="56" class="node-desc">MITM · HTTP/HTTPS · WebSocket · TLS · rule execution</text>
        <text x="16" y="72" class="node-desc node-desc-dim">interceptor chain: Script → Rule → Metrics → adapter</text>
      </g>

      <!-- storage -->
      <g class="node node-internal" transform="translate(32, 518)">
        <rect width="260" height="72" rx="4" />
        <text x="12" y="20" class="badge badge-internal">INTERNAL</text>
        <text x="12" y="38" class="node-name">relay-core-storage</text>
        <text x="12" y="54" class="node-desc">SQLite</text>
        <text x="12" y="68" class="node-desc node-desc-dim">optional persist · flows · audit</text>
      </g>

      <!-- script -->
      <g class="node node-internal" transform="translate(330, 518)">
        <rect width="260" height="72" rx="4" />
        <text x="12" y="20" class="badge badge-internal">INTERNAL</text>
        <text x="12" y="38" class="node-name">relay-core-script</text>
        <text x="12" y="54" class="node-desc">Deno/V8 (optional)</text>
      </g>
    </g>

    <g class="connectors connectors-engine">
      <path d="M 162 516 L 162 502" class="connector connector-dashed" fill="none" marker-end="url(#arch-arrow-optional)" />
      <line x1="460" y1="516" x2="460" y2="502" class="connector" marker-end="url(#arch-arrow)" />
      <text x="472" y="510" class="annotation">feature &quot;script&quot;</text>
    </g>
  </svg>
</div>

<style>
  .diagram-wrapper {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .architecture-svg {
    display: block;
    width: 100%;
    max-width: 920px;
    min-width: 640px;
    margin: 0 auto;
    height: auto;
  }

  .architecture-svg .layer-title {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    fill: var(--text-secondary);
  }

  .architecture-svg .layer-subtitle {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.06em;
    fill: var(--text-muted);
    text-transform: lowercase;
  }

  .architecture-svg .layer-frame {
    fill: var(--bg-elevated);
    stroke: var(--border-highlight);
    stroke-width: 1;
  }

  .architecture-svg .layer-frame-engine {
    fill: color-mix(in srgb, var(--bg-elevated) 90%, var(--bg-secondary));
  }

  .architecture-svg .node rect:first-of-type {
    fill: var(--bg-secondary);
    stroke-width: 1;
  }

  .architecture-svg .node-public > rect:first-of-type {
    stroke: color-mix(in srgb, var(--accent-primary) 55%, var(--border-highlight));
  }

  .architecture-svg .node-internal > rect:first-of-type {
    stroke: var(--border-highlight);
  }

  .architecture-svg .node-runtime > rect:first-of-type {
    stroke: color-mix(in srgb, var(--accent-primary) 70%, var(--border-highlight));
  }

  .architecture-svg .node-lib > rect:first-of-type {
    fill: var(--bg-primary);
    stroke: color-mix(in srgb, var(--accent-primary) 25%, var(--border-highlight));
  }

  .architecture-svg .node-nested {
    fill: var(--bg-primary);
    stroke: var(--border-color);
    stroke-width: 1;
  }

  .architecture-svg .node-name {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    fill: var(--text-primary);
  }

  .architecture-svg .node-name-nested {
    font-size: 11px;
    fill: var(--accent-primary);
  }

  .architecture-svg .node-desc {
    font-family: var(--font-sans);
    font-size: 10px;
    fill: var(--text-secondary);
  }

  .architecture-svg .node-desc-dim {
    font-size: 9px;
    fill: var(--text-muted);
  }

  .architecture-svg .badge {
    font-family: var(--font-mono);
    font-size: 8px;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .architecture-svg .badge-public {
    fill: var(--accent-primary);
  }

  .architecture-svg .badge-internal {
    fill: var(--text-muted);
  }

  .architecture-svg .connectors {
    pointer-events: none;
  }

  .architecture-svg .connector {
    stroke: var(--accent-dim);
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .architecture-svg .connector-dashed {
    stroke-dasharray: 5 4;
    stroke: var(--text-muted);
  }

  .architecture-svg .marker-fill-solid {
    fill: var(--accent-dim);
  }

  .architecture-svg .marker-fill-optional {
    fill: var(--text-muted);
  }

  .architecture-svg .annotation {
    font-family: var(--font-mono);
    font-size: 9px;
    fill: var(--text-muted);
  }

  @media (max-width: 720px) {
    .architecture-svg {
      min-width: 560px;
    }
  }
</style>
