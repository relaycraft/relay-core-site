---
import { getLocaleFromUrl, getAlternateUrl } from '../i18n/translations';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;

const locale = getLocaleFromUrl(Astro.url);
const alternatePath = getAlternateUrl(Astro.url);
const alternateLocale = locale === 'en' ? 'zh-CN' : 'en';

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const alternateURL = new URL(alternatePath, Astro.site);
const xDefaultURL = locale === 'en' ? alternateURL : canonicalURL;
const socialImage = new URL(ogImage ?? '/og.png', Astro.site);
const socialImageSvg = new URL('/og.svg', Astro.site);

// JSON-LD: only emit on the home page (avoids Schema.org noise on every doc).
// SoftwareApplication/SourceCode gives GitHub and search engines a canonical
// description of the project. Keep fields minimal and verified.
const isHome =
  Astro.url.pathname === '/' || Astro.url.pathname === '/en/' ||
  Astro.url.pathname === '/en' || Astro.url.pathname === '';
const softwareJsonLd = isHome
  ? {
      '@context': 'https://schema.org',
      '@type': 'SoftwareSourceCode',
      name: 'RelayCore',
      description,
      url: canonicalURL.toString(),
      codeRepository: 'https://github.com/relaycraft/relay-core',
      programmingLanguage: 'Rust',
      license: 'https://opensource.org/licenses/MIT',
      author: {
        '@type': 'Organization',
        name: 'RelayCraft',
        url: 'https://relaycraft.dev',
      },
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Linux, macOS, Windows',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
    }
  : null;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
<link rel="alternate" hreflang={alternateLocale} href={alternateURL} />
<link rel="alternate" hreflang="x-default" href={xDefaultURL} />
<title>{title}</title>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="RelayCore" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={socialImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="RelayCore — Rust traffic interception engine" />
<meta property="og:locale" content={locale === 'en' ? 'en_US' : 'zh_CN'} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
<meta name="twitter:image:alt" content="RelayCore — Rust traffic interception engine" />

{softwareJsonLd && (
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(softwareJsonLd)}
  />
)}
