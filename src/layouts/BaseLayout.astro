---
import { translations, getLocaleFromUrl, getAlternateUrl } from '../i18n/translations';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'High-performance Rust traffic interception engine for HTTP/HTTPS/WebSocket capture, inspection, and modification.',
} = Astro.props;

const locale = getLocaleFromUrl(Astro.url);
const t = translations[locale];
const alternateUrl = getAlternateUrl(Astro.url);
const alternateLocale = locale === 'en' ? 'zh' : 'en';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="alternate" hreflang={alternateLocale} href={alternateUrl} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <nav class="nav-container">
        <a href={locale === 'zh' ? '/' : '/en/'} class="logo">
          <span class="logo-mark">[~]</span>
          <span class="logo-text">RELAYCORE</span>
        </a>
        <ul class="nav-links">
          <li><a href={locale === 'zh' ? '/#features' : '/en/#features'}>{t.nav.features}</a></li>
          <li><a href={locale === 'zh' ? '/#architecture' : '/en/#architecture'}>{t.nav.architecture}</a></li>
          <li><a href={locale === 'zh' ? '/docs/getting-started' : '/en/docs/getting-started'}>{t.nav.docs}</a></li>
          <li><a href={alternateUrl} class="lang-switch">
            {locale === 'en' ? '中文' : 'EN'}
          </a></li>
          <li><a href="https://github.com/relaycraft/relay-core" target="_blank" rel="noopener" class="nav-github">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            {t.nav.github}
          </a></li>
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-content">
        <div class="footer-brand">
          <a href={locale === 'zh' ? '/' : '/en/'} class="logo">
            <span class="logo-mark">[~]</span>
            <span class="logo-text">RELAYCORE</span>
          </a>
          <p class="footer-tagline">{t.footer.tagline}</p>
        </div>
        <div class="footer-links">
          <div class="footer-col">
            <h4>{t.footer.project}</h4>
            <a href="https://github.com/relaycraft/relay-core" target="_blank" rel="noopener">GitHub</a>
            <a href="https://docs.rs/relay-core-runtime" target="_blank">Documentation</a>
            <a href="https://github.com/relaycraft/relay-core/releases" target="_blank">Releases</a>
          </div>
          <div class="footer-col">
            <h4>{t.footer.crates}</h4>
            <a href="https://crates.io/crates/relay-core-runtime" target="_blank">relay-core-runtime</a>
            <a href="https://crates.io/crates/relay-core-http" target="_blank">relay-core-http</a>
            <a href="https://crates.io/crates/relay-core-probe" target="_blank">relay-core-probe</a>
          </div>
          <div class="footer-col">
            <h4>{t.footer.related}</h4>
            <a href="https://relaycraft.dev" target="_blank">RelayCraft</a>
            <a href="https://github.com/relaycraft" target="_blank">Organization</a>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <span>{t.footer.license}</span>
        <span>{t.footer.builtWith}</span>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg-primary: #050505;
    --bg-secondary: #0a0a0a;
    --bg-tertiary: #0f0f0f;
    --bg-elevated: #141414;
    --border-color: #1a1a1a;
    --border-highlight: #2a2a2a;

    --accent-primary: #00d4ff;
    --accent-secondary: #0099cc;
    --accent-dim: #006680;
    --accent-glow: rgba(0, 212, 255, 0.15);

    --text-primary: #e0e0e0;
    --text-secondary: #808080;
    --text-muted: #404040;

    --success: #00ff41;
    --warning: #ff9500;
    --error: #ff3366;

    --font-mono: 'JetBrains Mono', 'Fira Code', 'SF Mono', 'Consolas', monospace;

    --space-xs: 0.25rem;
    --space-sm: 0.5rem;
    --space-md: 1rem;
    --space-lg: 2rem;
    --space-xl: 4rem;

    --transition: 200ms cubic-bezier(0.4, 0, 0.2, 1);
    --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.4);
    --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.5);
    --shadow-lg: 0 8px 24px rgba(0, 0, 0, 0.6);
    --shadow-glow: 0 0 20px var(--accent-glow);
  }

  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-size: 14px;
    scroll-behavior: smooth;
  }

  body {
    font-family: var(--font-mono);
    background-color: var(--bg-primary);
    color: var(--text-primary);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    min-height: 100vh;
  }

  body::before {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background:
      radial-gradient(ellipse at 50% 0%, rgba(0, 212, 255, 0.03) 0%, transparent 50%),
      radial-gradient(ellipse at 100% 100%, rgba(0, 212, 255, 0.02) 0%, transparent 40%);
    pointer-events: none;
    z-index: -1;
  }

  ::selection {
    background: var(--accent-primary);
    color: var(--bg-primary);
  }

  ::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }

  ::-webkit-scrollbar-track {
    background: transparent;
  }

  ::-webkit-scrollbar-thumb {
    background: var(--border-highlight);
    border-radius: 3px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--text-muted);
  }

  a {
    color: var(--accent-primary);
    text-decoration: none;
    transition: color var(--transition);
  }

  a:hover {
    color: var(--accent-secondary);
  }

  h1, h2, h3, h4 {
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .section {
    padding: var(--space-xl) var(--space-lg);
    max-width: 1400px;
    margin: 0 auto;
  }

  .section-header {
    margin-bottom: var(--space-xl);
  }

  .section-label {
    display: block;
    color: var(--accent-primary);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-sm);
  }

  .section-title {
    font-size: 2rem;
    color: var(--text-primary);
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 var(--space-lg);
  }
</style>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(5, 5, 5, 0.85);
    backdrop-filter: blur(12px) saturate(180%);
    -webkit-backdrop-filter: blur(12px) saturate(180%);
    border-bottom: 1px solid var(--border-color);
  }

  .nav-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: var(--space-md) var(--space-lg);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    color: var(--text-primary);
    transition: var(--transition);
  }

  .logo:hover {
    color: var(--text-primary);
  }

  .logo-mark {
    color: var(--accent-primary);
    font-weight: 700;
    text-shadow: 0 0 10px var(--accent-glow);
  }

  .logo-text {
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    list-style: none;
  }

  .nav-links a {
    color: var(--text-secondary);
    font-size: 0.875rem;
    transition: var(--transition);
    position: relative;
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--accent-primary);
    transform: scaleX(0);
    transition: transform var(--transition);
  }

  .nav-links a:hover {
    color: var(--text-primary);
  }

  .nav-links a:hover::after {
    transform: scaleX(1);
  }

  .lang-switch {
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--border-highlight);
    border-radius: 2px;
    transition: var(--transition);
  }

  .lang-switch:hover {
    border-color: var(--accent-primary);
    box-shadow: 0 0 8px var(--accent-glow);
  }

  .nav-github {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    transition: var(--transition);
  }

  .nav-github:hover {
    color: var(--text-primary);
  }

  .site-footer {
    background: linear-gradient(180deg, var(--bg-secondary) 0%, var(--bg-primary) 100%);
    border-top: 1px solid var(--border-color);
    padding: var(--space-xl) var(--space-lg);
  }

  .footer-content {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--space-xl);
    margin-bottom: var(--space-xl);
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .footer-tagline {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-top: var(--space-sm);
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .footer-col h4 {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: var(--space-sm);
  }

  .footer-col a {
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .footer-col a:hover {
    color: var(--text-primary);
  }

  .footer-bottom {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    padding-top: var(--space-lg);
    border-top: 1px solid var(--border-color);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .nav-links {
      display: none;
    }

    .footer-content {
      grid-template-columns: 1fr;
    }

    .footer-links {
      grid-template-columns: 1fr;
    }
  }
</style>
