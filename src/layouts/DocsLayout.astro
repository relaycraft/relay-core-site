---
import BaseLayout from './BaseLayout.astro';
import { getLocaleFromUrl } from '../i18n/translations';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const currentPath = Astro.url.pathname;
const sidebarToggleLabel = locale === 'zh' ? '文档目录' : 'On this page';

const sidebar = locale === 'zh' ? [
  {
    heading: '快速入门',
    items: [
      { label: '快速开始', href: '/docs/getting-started' },
      { label: '安装', href: '/docs/installation' },
    ]
  },
  {
    heading: '核心概念',
    items: [
      { label: '架构', href: '/docs/architecture' },
      { label: '规则 API', href: '/docs/rule-engine' },
      { label: '规则编写指南', href: '/docs/rule-guide' },
      { label: '脚本 API', href: '/docs/scripting' },
      { label: '脚本开发指引', href: '/docs/scripting-guide' },
      { label: 'vs mitmproxy', href: '/docs/scripting-vs-mitmproxy' },
    ]
  },
  {
    heading: '参考',
    items: [
      { label: 'HTTP API', href: '/docs/api' },
      { label: 'CLI 参考', href: '/docs/cli' },
      { label: '配置', href: '/docs/configuration' },
      { label: '监控与可观测性', href: '/docs/observability' },
      { label: '故障排除', href: '/docs/troubleshooting' },
    ]
  },
  {
    heading: '集成',
    items: [
      { label: 'MCP 服务器', href: '/docs/mcp' },
      { label: 'Tauri 插件', href: '/docs/tauri-plugin' },
    ]
  }
] : [
  {
    heading: 'Getting Started',
    items: [
      { label: 'Quick Start', href: '/en/docs/getting-started' },
      { label: 'Installation', href: '/en/docs/installation' },
    ]
  },
  {
    heading: 'Core Concepts',
    items: [
      { label: 'Architecture', href: '/en/docs/architecture' },
      { label: 'Rule API', href: '/en/docs/rule-engine' },
      { label: 'Rule Guide', href: '/en/docs/rule-guide' },
      { label: 'Scripting API', href: '/en/docs/scripting' },
      { label: 'Scripting Guide', href: '/en/docs/scripting-guide' },
      { label: 'vs mitmproxy', href: '/en/docs/scripting-vs-mitmproxy' },
    ]
  },
  {
    heading: 'Reference',
    items: [
      { label: 'HTTP API', href: '/en/docs/api' },
      { label: 'CLI Reference', href: '/en/docs/cli' },
      { label: 'Configuration', href: '/en/docs/configuration' },
      { label: 'Monitoring', href: '/en/docs/observability' },
      { label: 'Troubleshooting', href: '/en/docs/troubleshooting' },
    ]
  },
  {
    heading: 'Integrations',
    items: [
      { label: 'MCP Server', href: '/en/docs/mcp' },
      { label: 'Tauri Plugin', href: '/en/docs/tauri-plugin' },
    ]
  }
];

function isActive(href: string) {
  return currentPath.endsWith(href);
}
---

<BaseLayout title={`${title} — RelayCore`} description={description}>
  <div class="docs-wrapper">
    <button class="docs-sidebar-toggle" aria-expanded="false" aria-controls="docs-sidebar">
      {sidebarToggleLabel}
    </button>

    <aside class="docs-sidebar" id="docs-sidebar">
      <div class="sidebar-inner">
        {sidebar.map(section => (
          <div class="sidebar-section">
            <p class="sidebar-heading">{section.heading}</p>
            <ul class="sidebar-list">
              {section.items.map(item => (
                <li>
                  <a
                    href={item.href}
                    class:list={[{ active: isActive(item.href) }]}
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </aside>

    <article class="docs-content">
      <slot />
    </article>
  </div>

  <script>
    const toggle = document.querySelector('.docs-sidebar-toggle');
    const sidebar = document.getElementById('docs-sidebar');
    if (toggle && sidebar) {
      toggle.addEventListener('click', () => {
        const isOpen = sidebar.classList.toggle('open');
        toggle.setAttribute('aria-expanded', String(isOpen));
      });
    }
  </script>
</BaseLayout>

<style>
  .docs-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: var(--space-xl) var(--space-lg);
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: var(--space-xl);
    align-items: start;
  }

  @media (max-width: 900px) {
    .docs-wrapper {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .docs-sidebar-toggle {
      display: flex;
    }

    .docs-sidebar {
      display: none;
      position: static;
    }

    .docs-sidebar.open {
      display: block;
      padding: var(--space-md);
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      border-radius: 6px;
    }
  }

  .docs-sidebar-toggle {
    display: none;
    align-items: center;
    gap: var(--space-sm);
    width: fit-content;
    padding: var(--space-sm) var(--space-md);
    font-size: 0.8125rem;
    color: var(--text-secondary);
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 4px;
    cursor: pointer;
    transition: var(--transition);
  }

  .docs-sidebar-toggle:hover {
    color: var(--accent-primary);
    border-color: var(--border-highlight);
  }

  .docs-sidebar-toggle::before {
    content: '☰';
    color: var(--accent-primary);
    font-size: 0.875rem;
  }

  .docs-sidebar {
    position: sticky;
    top: 80px;
  }

  .sidebar-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .sidebar-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .sidebar-heading {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--text-primary);
    padding-bottom: var(--space-sm);
    margin-bottom: var(--space-xs);
    border-bottom: 1px solid var(--border-color);
  }

  .sidebar-heading::before {
    content: '// ';
    color: var(--accent-primary);
    font-weight: 500;
  }

  .sidebar-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .sidebar-list a {
    display: block;
    padding: var(--space-sm) var(--space-sm);
    font-size: 0.8125rem;
    color: var(--text-secondary);
    border-radius: 4px;
    transition: var(--transition);
    border-left: 2px solid transparent;
  }

  .sidebar-list a:hover {
    color: var(--text-primary);
    background: var(--bg-secondary);
  }

  .sidebar-list a.active {
    color: var(--accent-primary);
    background: rgba(0, 212, 255, 0.08);
    border-left-color: var(--accent-primary);
    text-shadow: 0 0 8px var(--accent-glow);
  }

  .docs-content {
    min-width: 0;
    max-width: 900px;
  }

  .docs-content :global(h1) {
    font-size: 2.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-lg);
    color: var(--text-primary);
    line-height: 1.25;
    background: linear-gradient(135deg, var(--text-primary) 0%, var(--accent-primary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  :global(:lang(zh)) .docs-content h1 {
    letter-spacing: 0.02em;
  }

  :global(:lang(en)) .docs-content h1 {
    letter-spacing: -0.02em;
  }

  .docs-content :global(h2) {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-top: var(--space-xl);
    margin-bottom: var(--space-md);
    color: var(--text-primary);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--border-color);
  }

  .docs-content :global(h3) {
    font-size: 1.125rem;
    font-weight: 600;
    margin-top: var(--space-lg);
    margin-bottom: var(--space-md);
    color: var(--text-primary);
  }

  .docs-content :global(p) {
    margin-bottom: var(--space-md);
    color: var(--text-secondary);
    line-height: 1.8;
    font-size: 0.9375rem;
  }

  .docs-content :global(ul),
  .docs-content :global(ol) {
    margin-bottom: var(--space-md);
    padding-left: var(--space-lg);
    color: var(--text-secondary);
  }

  .docs-content :global(li) {
    margin-bottom: var(--space-sm);
    line-height: 1.7;
    font-size: 0.9375rem;
  }

  .docs-content :global(a) {
    color: var(--accent-primary);
  }

  .docs-content :global(a:hover) {
    text-decoration: underline;
  }

  .docs-content :global(code) {
    font-size: 0.875em;
    background: var(--bg-tertiary);
    color: var(--accent-primary);
    padding: 0.15em 0.4em;
    border-radius: 3px;
    border: 1px solid var(--border-color);
  }

  .docs-content :global(pre) {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    padding: var(--space-md);
    margin: var(--space-md) 0;
    overflow-x: auto;
    font-size: 0.8125rem;
    line-height: 1.8;
    box-shadow: var(--shadow-sm);
    border-top: 2px solid rgba(0, 212, 255, 0.2);
  }

  .docs-content :global(.copy-wrap pre) {
    padding-top: calc(var(--space-md) + 0.75rem);
    margin: var(--space-md) 0;
  }

  .docs-content :global(pre code:not(.shiki)) {
    background: none;
    border: none;
    padding: 0;
    font-size: inherit;
    color: var(--text-secondary);
  }

  .docs-content :global(pre code.shiki) {
    background: none;
    border: none;
    padding: 0;
    font-size: inherit;
    display: block;
  }

  .docs-content :global(.diagram-wrapper) {
    margin: var(--space-lg) 0;
    display: flex;
    justify-content: center;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: var(--space-lg);
  }

  .docs-content :global(.diagram-wrapper img) {
    max-width: 100%;
    height: auto;
  }

  .docs-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-lg) 0;
    font-size: 0.875rem;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    overflow: hidden;
  }

  .docs-content :global(th),
  .docs-content :global(td) {
    text-align: left;
    padding: var(--space-sm) var(--space-md);
    border-bottom: 1px solid var(--border-color);
  }

  .docs-content :global(th) {
    font-weight: 600;
    color: var(--text-primary);
    background: var(--bg-secondary);
  }

  .docs-content :global(td) {
    color: var(--text-secondary);
  }

  .docs-content :global(tr:hover td) {
    background: rgba(0, 212, 255, 0.03);
  }

  .docs-content :global(strong) {
    color: var(--text-primary);
    font-weight: 600;
  }

  .docs-content :global(.endpoint) {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-sm) var(--space-md);
    margin: var(--space-sm) 0;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 4px;
    transition: var(--transition);
  }

  .docs-content :global(.endpoint:hover) {
    border-color: var(--border-highlight);
    background: var(--bg-tertiary);
  }

  .docs-content :global(.endpoint:hover .copy-btn-inline),
  .docs-content :global(.endpoint:focus-within .copy-btn-inline) {
    opacity: 1;
  }

  .docs-content :global(.endpoint span:not(.method)) {
    flex: 1;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-secondary);
    word-break: break-all;
    min-width: 0;
  }

  .docs-content :global(.metric-grid) {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
    margin: var(--space-lg) 0;
  }

  .docs-content :global(.metric-card) {
    padding: var(--space-lg);
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 4px;
    text-align: center;
    transition: var(--transition);
  }

  .docs-content :global(.metric-card:hover) {
    border-color: rgba(0, 212, 255, 0.3);
    box-shadow: 0 0 12px var(--accent-glow);
  }

  .docs-content :global(.metric-value) {
    font-size: 2rem;
    font-weight: 700;
    color: var(--accent-primary);
    line-height: 1;
  }

  .docs-content :global(.metric-label) {
    font-size: 0.75rem;
    color: var(--text-secondary);
    margin-top: var(--space-sm);
  }
</style>
