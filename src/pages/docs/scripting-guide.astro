---
import DocsLayout from '../../layouts/DocsLayout.astro';
---

<DocsLayout title="脚本开发指引" description="RelayCore 脚本开发常用模式和最佳实践">
  <h1>脚本开发指引</h1>

  <p>本指南涵盖使用 RelayCore 脚本引擎的常用模式、最佳实践和调试技巧。</p>

  <h2>快速开始</h2>
  <pre><code>// script.js — 最简脚本
globalThis.onRequest = (ctx, flow) => &#123;
  console.log(`$&#123;#36;&#123;flow.request.method&#125; $&#123;#36;&#123;flow.request.url&#125;`);
&#125;;</code></pre>
  <p>通过 HTTP API 加载：</p>
  <pre><code>curl -X POST http://127.0.0.1:18082/api/v1/script \
  -H "Content-Type: application/json" \
  -d '&#123;"name": "logger", "source": "globalThis.onRequest = (ctx, flow) => &#123; console.log(flow.request.url); &#125;"&#125;'</code></pre>

  <h2>常用模式</h2>

  <h3>1. 认证注入</h3>
  <p>为所有到内部 API 的请求自动注入认证头：</p>
  <pre><code>globalThis.onRequestHeaders = (ctx, flow) => &#123;
  if (flow.request.url.includes("/api/")) &#123;
    const existing = flow.request.headers.find(h => h[0] === "authorization");
    if (!existing) &#123;
      flow.request.headers.push(["authorization", "Bearer $&#123;#36;&#123;getToken()&#125;"]);
    &#125;
  &#125;
  return flow;  // 返回修改后的 flow
&#125;;

function getToken() &#123;
  return relay.env("API_TOKEN") || "dev-token";
&#125;</code></pre>

  <h3>2. Mock 响应</h3>
  <p>在请求阶段拦截并返回模拟响应，无需真实后端：</p>
  <pre><code>const mocks = &#123;
  "/api/users": [&#123; id: 1, name: "Alice" &#125;, &#123; id: 2, name: "Bob" &#125;],
  "/api/health": &#123; status: "ok", version: "1.0" &#125;,
&#125;;

globalThis.onRequest = (ctx, flow) => &#123;
  const path = new URL(flow.request.url).pathname;
  if (mocks[path]) &#123;
    const body = JSON.stringify(mocks[path]);
    return &#123;
      action: "respond",
      status: 200,
      headers: [["content-type", "application/json"]],
      body: body,
    &#125;;
  &#125;
  // 未匹配继续正常代理
&#125;;</code></pre>

  <h3>3. 请求重写</h3>
  <p>修改请求目标，将 API 调用重定向到不同环境：</p>
  <pre><code>globalThis.onRequestHeaders = (ctx, flow) => &#123;
  // 将 prod API 调用重定向到 staging
  if (flow.request.url.includes("api.example.com")) &#123;
    flow.request.url = flow.request.url.replace(
      "api.example.com",
      "staging.example.com"
    );
    // 更新 Host header
    flow.request.headers = flow.request.headers.filter(
      h => h[0].toLowerCase() !== "host"
    );
    flow.request.headers.push(["host", "staging.example.com"]);
  &#125;
  return flow;
&#125;;</code></pre>

  <h3>4. 响应脱敏</h3>
  <p>自动移除敏感字段如手机号、证件号：</p>
  <pre><code>globalThis.onResponse = (ctx, flow) => &#123;
  if (!flow.response?.body) return;
  const raw = atob(flow.response.body.content);
  if (!isJson(raw)) return;

  const data = relay.json.parseSafe(raw);
  if (!data) return;

  const sanitized = redactPersonalInfo(data);
  const newBody = relay.json.stringifyPretty(sanitized);
  flow.response.body.content = btoa(newBody);
  flow.response.body.size = newBody.length;
&#125;;

function redactPersonalInfo(obj) &#123;
  if (typeof obj !== "object" || obj === null) return obj;
  if (Array.isArray(obj)) return obj.map(redactPersonalInfo);
  const result = &#123;&#125;;
  for (const [k, v] of Object.entries(obj)) &#123;
    if (/phone|mobile|id_card|ssn/i.test(k)) &#123;
      result[k] = "***REDACTED***";
    &#125; else &#123;
      result[k] = redactPersonalInfo(v);
    &#125;
  &#125;
  return result;
&#125;

function isJson(s) &#123;
  try &#123; JSON.parse(s); return true; &#125; catch &#123; return false; &#125;
&#125;</code></pre>

  <h3>5. 限速与熔断</h3>
  <p>通过 sharedState 实现简单的请求计数和限速：</p>
  <pre><code>const RATE_LIMIT = 100;
const WINDOW_MS = 60_000;

globalThis.onRequest = (ctx, flow) => &#123;
  const ip = flow.network.client_ip;
  const now = Date.now();

  if (!sharedState._rateLimit) sharedState._rateLimit = &#123;&#125;;
  const entry = sharedState._rateLimit[ip] || &#123; count: 0, reset: now + WINDOW_MS &#125;;

  if (now > entry.reset) &#123;
    entry.count = 0;
    entry.reset = now + WINDOW_MS;
  &#125;

  entry.count++;
  sharedState._rateLimit[ip] = entry;

  if (entry.count > RATE_LIMIT) &#123;
    console.warn(`Rate limit exceeded for $&#123;#36;&#123;ip&#125; ($&#123;#36;&#123;entry.count&#125;/$&#123;#36;&#123;RATE_LIMIT&#125;)`);
    return &#123;
      action: "respond",
      status: 429,
      headers: [["content-type", "text/plain"]],
      body: "Too Many Requests",
    &#125;;
  &#125;
&#125;;</code></pre>

  <h3>6. 跨钩子上下文传递</h3>
  <p>使用 sharedState 在请求和响应之间传递数据：</p>
  <pre><code>globalThis.onRequest = (ctx, flow) => &#123;
  sharedState[flow.id] = &#123;
    startTime: Date.now(),
    authType: flow.request.headers.find(h => h[0] === "authorization")
      ? "bearer" : "none",
  &#125;;
&#125;;

globalThis.onResponse = (ctx, flow) => &#123;
  const meta = sharedState[flow.id];
  if (!meta) return;

  const duration = Date.now() - meta.startTime;
  if (duration > 5000) &#123;
    console.warn(`Slow request: $&#123;#36;&#123;flow.request.url&#125; ($&#123;#36;&#123;duration&#125;ms, auth=$&#123;#36;&#123;meta.authType&#125;)`);
  &#125;

  // 每条流处理完立即清理
  delete sharedState[flow.id];
&#125;;</code></pre>

  <h3>7. 连接 IP 黑名单</h3>
  <p>在 TCP 连接建立时直接拒绝：</p>
  <pre><code>const BLOCKED_NETS = ["10.0.0.", "192.168.254."];

globalThis.onConnect = (ctx, conn) => &#123;
  for (const net of BLOCKED_NETS) &#123;
    if (conn.client_ip.startsWith(net)) &#123;
      console.warn(`Blocked connection from $&#123;#36;&#123;conn.client_ip&#125;`);
      return &#123; drop: true &#125;;
    &#125;
  &#125;
&#125;;</code></pre>

  <h3>8. 外部鉴权（relay.fetch）</h3>
  <p>调用外部服务验证每个请求：</p>
  <pre><code>globalThis.onRequest = async (ctx, flow) => &#123;
  const auth = flow.request.headers.find(h => h[0] === "authorization");
  if (!auth) return;

  try &#123;
    const resp = await relay.fetch("http://auth.internal/verify", &#123;
      method: "POST",
      headers: &#123; "Content-Type": "application/json" &#125;,
      body: JSON.stringify(&#123; token: auth[1] &#125;),
      timeout_ms: 3000,
    &#125;);

    if (resp.status !== 200) &#123;
      return &#123;
        action: "respond",
        status: 401,
        headers: [["content-type", "text/plain"]],
        body: "Authentication failed",
      &#125;;
    &#125;
  &#125; catch (e) &#123;
    console.error("Auth service unreachable:", e);
    // fail-open: 允许通过
  &#125;
&#125;;</code></pre>

  <h2>调试技巧</h2>

  <h3>日志级别</h3>
  <pre><code>// 开发时用 console.debug，生产不可见
console.debug("Flow id:", flow.id);          // RUST_LOG=relay_core_script=debug
console.log("Request handled");              // 默认可见
console.error("This should not happen!");    // 永远可见</code></pre>

  <h3>onError 全局捕获</h3>
  <pre><code>globalThis.onError = (ctx, flow, error, stage) => &#123;
  // stage 告诉你哪个钩子出错了
  console.error(`[$&#123;#36;&#123;stage&#125;] $&#123;#36;&#123;error&#125;`);
  // 记录详细信息用于排查
  sharedState._errors = sharedState._errors || [];
  sharedState._errors.push(&#123;
    flow_id: flow?.id,
    stage,
    message: String(error),
    time: new Date().toISOString(),
  &#125;);
&#125;;</code></pre>

  <h3>Prometheus 指标</h3>
  <pre><code># 查看脚本执行指标
curl http://127.0.0.1:18082/api/v1/metrics/prometheus | grep script_
# 输出：script_hook_duration_us&#123;hook="onRequest"&#125;
#       script_hook_invocations_total&#123;hook="onRequest"&#125; 12345</code></pre>

  <h2>性能注意事项</h2>
  <ul>
    <li><strong>钩子执行阻塞代理线程</strong>——单个钩子 > 10ms 会显著影响吞吐</li>
    <li><strong>避免同步大文件处理</strong>——对 > 1MB body 进行 JSON 解析会导致 OOM</li>
    <li><strong>sharedState 及时清理</strong>——不清理会导致内存增长（旧条目 > 10k 时发 warning）</li>
    <li><strong>relay.fetch 有并发上限</strong>——默认最大 8 个并发请求，超出会排队等待</li>
    <li><strong>引擎池独立 V8 isolate</strong>——不同引擎的 sharedState 互不可见（同 flow 保证路同引擎）</li>
    <li><strong>Bundle 模式打包</strong>——用 esbuild 的 <code>--minify</code> 可以减少脚本加载时间</li>
  </ul>

  <h2>测试脚本</h2>
  <p>无需启动完整代理即可在单元测试中验证脚本逻辑：</p>
  <pre><code># Rust 侧已有完整的脚本集成测试
# 见 relay-core-script/tests/integration_test.rs
cargo test --package relay-core-script

# 覆盖：全部 11 钩子、relay.* 工具、relay.fetch、
#       env 白名单、sharedState、onError、
#       matched_rules、rule_variables</code></pre>
</DocsLayout>
