---
import BaseLayout from '../layouts/BaseLayout.astro';
import CopyBlock from '../components/CopyBlock.astro';
import CopyButton from '../components/CopyButton.astro';
import EndpointRow from '../components/EndpointRow.astro';
import FeatureIcon from '../components/FeatureIcon.astro';
import InstallIcon from '../components/InstallIcon.astro';
import TerminalDots from '../components/TerminalDots.astro';
import '../styles/home.css';
import { translations, getLocaleFromUrl } from '../i18n/translations';

const locale = getLocaleFromUrl(Astro.url);
const t = translations[locale];

const apiSampleJson = `{
  "flows": [
    {
      "id": "fld_01HX5K9P3Q8Y2Z7",
      "method": "GET",
      "path": "/users",
      "status": 200,
      "duration_ms": 42
    }
  ],
  "pagination": {
    "total": 12847,
    "returned": 10,
    "offset": 0
  }
}`;

const apiRequestUrl = 'http://127.0.0.1:3000/api/v1/flows?limit=10';
---

<BaseLayout title="RelayCore — Rust 流量拦截引擎">
  <section class="hero">
    <div class="hero-grid">
      <div class="terminal-window">
        <div class="terminal-chrome">
          <span class="chrome-dot red"></span>
          <span class="chrome-dot yellow"></span>
          <span class="chrome-dot green"></span>
          <span class="chrome-title">relay-core — zsh</span>
        </div>
        <pre class="terminal-body"><span class="prompt">$</span> <span class="cmd">cargo install relay-core-cli</span>
<span class="output">  Installing relay-core-cli v0.3.5...</span>
<span class="output">  Finished [debug] target 2.3MB 0.42s</span>

<span class="prompt">$</span> <span class="cmd">relay-core-cli run --port 8080</span>
<span class="output">> RelayCore v0.3.5 initializing...</span>
<span class="output">> Loading configuration from ~/.relay-core/config.toml</span>
<span class="output">> Starting HTTP proxy on 0.0.0.0:8080</span>
<span class="output">> MCP server listening on :25519</span>
<span class="output">> REST API available at http://127.0.0.1:3000/api/v1/</span>
<span class="output">> 10,247 flows captured this session</span>
<span class="cursor">▋</span></pre>
      </div>

      <div class="hero-content">
        <h1 class="hero-title">
          <span class="title-line">{t.hero.title.split(' ').slice(0, 2).join(' ')}</span>
          <span class="title-line accent">{t.hero.title.split(' ').slice(2).join(' ')}</span>
        </h1>
        <p class="hero-subtitle" set:html={t.hero.subtitle.replace('. ', '.<br>')}></p>
        <div class="hero-cta">
          <a href="/docs/getting-started" class="btn btn-primary">{t.hero.getStarted}</a>
          <a href="https://docs.rs/relay-core-runtime" target="_blank" class="btn btn-secondary">{t.hero.viewDocs}</a>
        </div>
      </div>
    </div>
  </section>

  <section id="features" class="section features">
    <div class="section-header">
      <span class="section-label">{t.features.label}</span>
      <h2 class="section-title">{t.features.title}</h2>
    </div>

    <div class="features-grid">
      <div class="feature">
        <FeatureIcon name="mitm" />
        <h3 class="feature-title">{t.features.mitm.title}</h3>
        <p class="feature-desc">{t.features.mitm.desc}</p>
      </div>

      <div class="feature">
        <FeatureIcon name="websocket" />
        <h3 class="feature-title">{t.features.websocket.title}</h3>
        <p class="feature-desc">{t.features.websocket.desc}</p>
      </div>

      <div class="feature">
        <FeatureIcon name="rule" />
        <h3 class="feature-title">{t.features.rule.title}</h3>
        <p class="feature-desc">{t.features.rule.desc}</p>
      </div>

      <div class="feature">
        <FeatureIcon name="script" />
        <h3 class="feature-title">{t.features.script.title}</h3>
        <p class="feature-desc">{t.features.script.desc}</p>
      </div>

      <div class="feature">
        <FeatureIcon name="breakpoint" />
        <h3 class="feature-title">{t.features.breakpoints.title}</h3>
        <p class="feature-desc">{t.features.breakpoints.desc}</p>
      </div>

      <div class="feature">
        <FeatureIcon name="metrics" />
        <h3 class="feature-title">{t.features.metrics.title}</h3>
        <p class="feature-desc">{t.features.metrics.desc}</p>
      </div>
    </div>
  </section>

  <section id="architecture" class="section architecture">
    <div class="section-header">
      <span class="section-label">// STRUCTURE</span>
      <h2 class="section-title">架构</h2>
    </div>

    <div class="architecture-diagram">
      <pre class="ascii-diagram">┌──────────────────────────────────────────────────────────────────────────┐
│                         Adapter Layer (PUBLIC)                           │
│  ┌───────────┐  ┌───────────┐  ┌───────────┐  ┌───────────┐            │
│  │  HTTP API │  │    MCP    │  │   Tauri   │  │  CLI/TUI  │            │
│  │ REST + SSE│  │AI Adapter │  │ Desktop   │  │ Terminal  │            │
│  └─────┬─────┘  └─────┬─────┘  └─────┬─────┘  └─────┬─────┘            │
└─────────┼──────────────┼──────────────┼──────────────┼───────────────────┘
          └──────────────┴───────┬──────┴──────────────┘
                                 │
                    ┌────────────▼────────────┐
                    │    relay-core-runtime    │
                    │  ┌──────────────────┐   │
                    │  │    CoreState     │   │
                    │  │  State & Events  │   │
                    │  └──────────────────┘   │
                    └────────────┬────────────┘
                                 │
┌───────────────────────────────┼───────────────────────────────────────────┤
│                        Proxy Engine (INTERNAL)                          │
│                    ┌──────────┼──────────┐                               │
│           ┌────────▼────────┐│┌─────────▼─────────┐                     │
│           │ relay-core-lib  │││relay-core-storage  │                     │
│           │  MITM/Proxy/TLS │││      SQLite        │                     │
│           └─────────────────┘│└───────────────────┘                     │
│                              │                    ┌───────────────────┐  │
│                              │                    │relay-core-script  │  │
│                              │                    │     Deno/V8       │  │
│                              │                    └───────────────────┘  │
└──────────────────────────────┴───────────────────────────────────────────┘</pre>
    </div>

    <div class="crates-grid">
      <div class="crate-item public">
        <span class="crate-badge">PUBLIC</span>
        <span class="crate-name">relay-core-runtime</span>
        <span class="crate-desc">状态编排、生命周期、规则</span>
      </div>
      <div class="crate-item public">
        <span class="crate-badge">PUBLIC</span>
        <span class="crate-name">relay-core-http</span>
        <span class="crate-desc">REST + SSE 适配器</span>
      </div>
      <div class="crate-item beta">
        <span class="crate-badge">BETA</span>
        <span class="crate-name">relay-core-probe</span>
        <span class="crate-desc">AI 代理 MCP 适配器</span>
      </div>
      <div class="crate-item beta">
        <span class="crate-badge">BETA</span>
        <span class="crate-name">relay-core-cli</span>
        <span class="crate-desc">独立 CLI 和 TUI</span>
      </div>
      <div class="crate-item internal">
        <span class="crate-badge">INTERNAL</span>
        <span class="crate-name">relay-core-lib</span>
        <span class="crate-desc">核心引擎：MITM、TLS、代理</span>
      </div>
      <div class="crate-item internal">
        <span class="crate-badge">INTERNAL</span>
        <span class="crate-name">relay-core-storage</span>
        <span class="crate-desc">SQLite 持久化</span>
      </div>
    </div>
  </section>

  <section id="performance" class="section performance">
    <div class="section-header">
      <span class="section-label">// METRICS</span>
      <h2 class="section-title">性能</h2>
    </div>

    <div class="metrics-grid">
      <div class="metric-card">
        <div class="metric-value">&gt;10K</div>
        <div class="metric-unit">req/s</div>
        <div class="metric-label">吞吐量 (S1)</div>
      </div>
      <div class="metric-card">
        <div class="metric-value">&lt;200</div>
        <div class="metric-unit">ms</div>
        <div class="metric-label">冷启动</div>
      </div>
      <div class="metric-card">
        <div class="metric-value">&lt;50</div>
        <div class="metric-unit">MB</div>
        <div class="metric-label">空闲 RSS</div>
      </div>
      <div class="metric-card">
        <div class="metric-value">&lt;5</div>
        <div class="metric-unit">ms</div>
        <div class="metric-label">P99 延迟增加</div>
      </div>
    </div>

    <div class="comparison-table">
      <div class="table-header">
        <span>指标</span>
        <span>RelayCore</span>
        <span>mitmproxy</span>
        <span>Charles</span>
      </div>
      <div class="table-row">
        <span class="row-label">语言</span>
        <span class="row-value highlight">Rust</span>
        <span>Python</span>
        <span>Java</span>
      </div>
      <div class="table-row">
        <span class="row-label">吞吐量</span>
        <span class="row-value highlight">10K+ req/s</span>
        <span>~1K req/s</span>
        <span>~2K req/s</span>
      </div>
      <div class="table-row">
        <span class="row-label">内存 (空闲)</span>
        <span class="row-value highlight">38MB</span>
        <span>~150MB</span>
        <span>~300MB</span>
      </div>
      <div class="table-row">
        <span class="row-label">P99 开销</span>
        <span class="row-value highlight">&lt;5ms</span>
        <span>~50ms</span>
        <span>~30ms</span>
      </div>
    </div>
  </section>

  <section id="api" class="section api">
    <div class="section-header">
      <span class="section-label">// REST API</span>
      <h2 class="section-title">HTTP API</h2>
    </div>

    <div class="api-example">
      <div class="api-request copy-wrap-inline">
        <span class="method method-get">GET</span>
        <span class="http-url">{apiRequestUrl}</span>
        <CopyButton inline text={apiRequestUrl} />
      </div>

      <div class="api-response">
        <div class="response-label">Response 200 OK</div>
        <CopyBlock>
          <pre class="code-block">{apiSampleJson}</pre>
        </CopyBlock>
      </div>
    </div>

    <div class="endpoints-table">
      <EndpointRow method="get" path="/api/v1/flows" desc="搜索和分页流量" />
      <EndpointRow method="get" path="/api/v1/flows/:id" desc="获取流量详情" />
      <EndpointRow method="get" path="/api/v1/rules" desc="列出所有规则" />
      <EndpointRow method="put" path="/api/v1/rules" desc="更新或创建规则" />
      <EndpointRow method="delete" path="/api/v1/rules/:id" desc="删除规则" />
      <EndpointRow method="post" path="/api/v1/intercepts" desc="创建拦截规则" />
      <EndpointRow method="get" path="/api/v1/events" desc="SSE 实时更新流" />
      <EndpointRow method="get" path="/api/v1/metrics/prometheus" desc="Prometheus 格式指标" />
    </div>
  </section>

  <section id="cli" class="section cli">
    <div class="section-header">
      <span class="section-label">// COMMAND LINE</span>
      <h2 class="section-title">CLI 参考</h2>
    </div>

    <div class="cli-examples">
      <div class="cli-block">
        <div class="cli-prompt"><TerminalDots /> $ relay-core-cli run</div>
        <pre class="cli-output">> RelayCore v0.3.5
> Proxy listening on 0.0.0.0:8080
> Web UI: http://127.0.0.1:8080/ui
> Press Ctrl+C to stop</pre>
      </div>

      <div class="cli-block">
        <div class="cli-prompt"><TerminalDots /> $ relay-core-cli ca init</div>
        <pre class="cli-output">> Generating new CA certificate...
> CA certificate generated successfully
> Path: ~/.relay-core/ca.crt</pre>
      </div>

      <div class="cli-block">
        <div class="cli-prompt"><TerminalDots /> $ relay-core-cli rules list</div>
        <pre class="cli-output"> ID       PRIORITY  FILTER                    ACTION    ENABLED
────────────────────────────────────────────────────────────
 rul_01      100     method:GET host:*.example.com  log       true
 rul_02       90     path:/api/v2/*                intercept  true</pre>
      </div>

      <div class="cli-block">
        <div class="cli-prompt"><TerminalDots /> $ relay-core-cli flows --limit 5</div>
        <pre class="cli-output"> TIME     METHOD  PATH                    STATUS  DURATION
───────────────────────────────────────────────────────────
 10:23:45  GET     /users/relaycraft        200     45ms
 10:23:42  POST    /repos                  201     120ms
 10:23:38  GET     /search?q=relay-core     200     89ms</pre>
      </div>
    </div>

    <div class="cli-commands">
      <div class="cmd-item">
        <code>relay-core-cli run</code>
        <span>启动代理服务器</span>
      </div>
      <div class="cmd-item">
        <code>relay-core-cli run --ui</code>
        <span>启动 TUI 界面</span>
      </div>
      <div class="cmd-item">
        <code>relay-core-cli ca init</code>
        <span>CA 证书管理</span>
      </div>
      <div class="cmd-item">
        <code>relay-core-cli rules list</code>
        <span>规则管理</span>
      </div>
      <div class="cmd-item">
        <code>relay-core-cli flows</code>
        <span>查询捕获的流量</span>
      </div>
      <div class="cmd-item">
        <code>relay-core-cli metrics</code>
        <span>查看运行时指标</span>
      </div>
    </div>
  </section>

  <section id="get-started" class="section get-started">
    <div class="section-header">
      <span class="section-label">{t.install.label}</span>
      <h2 class="section-title">{t.install.title}</h2>
    </div>

    <div class="install-options">
      <div class="install-card">
        <InstallIcon name="cargo" />
        <h3>{t.install.cargo}</h3>
        <CopyBlock text={t.install.cargoCmd}>
          <pre class="install-cmd">{t.install.cargoCmd}</pre>
        </CopyBlock>
      </div>

      <div class="install-card">
        <InstallIcon name="npm" />
        <h3>{t.install.npm}</h3>
        <CopyBlock text={t.install.npmCmd}>
          <pre class="install-cmd">{t.install.npmCmd}</pre>
        </CopyBlock>
      </div>

      <div class="install-card">
        <InstallIcon name="source" />
        <h3>{t.install.source}</h3>
        <CopyBlock text={t.install.sourceCmd}>
          <pre class="install-cmd">{t.install.sourceCmd}</pre>
        </CopyBlock>
      </div>
    </div>

    <div class="next-steps">
      <h3>{t.nextSteps}</h3>
      <ul>
        <li><a href="https://docs.rs/relay-core-runtime" target="_blank">{t.nextStepsLinks.rustDocs}</a></li>
        <li><a href="https://github.com/relaycraft/relay-core" target="_blank">{t.nextStepsLinks.github}</a></li>
        <li><a href="https://github.com/relaycraft/relay-core/releases" target="_blank">{t.nextStepsLinks.releases}</a></li>
        <li><a href="/docs/getting-started">{t.nextStepsLinks.docs}</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>